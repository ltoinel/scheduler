{
    "name": "node-red-contrib-scheduler-plus",
    "version": "1.1.0",
    "description": "A Node Red Timer with dusk, dawn and months",
    "author": "Peter Scargill <pete@scargill.org>",
    "contributors": [
        "Ludovic Toinel"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ltoinel/scheduler.git"
    },
    "bugs": {
        "url": "https://github.com/ltoinel/scheduler/issues"
    },
    "homepage": "https://github.com/ltoinel/scheduler#readme",
    "dependencies": {
        "suncalc": "^2.1.1"
    },
    "keywords": [
        "node-red",
        "scheduler",
        "timer",
        "dusk",
        "dawn"
    ],
    "files": [
        "scheduler.js",
        "scheduler.html",
        "icons/"
    ],
    "scripts": {
        "lint": "eslint .",
        "test": "node --test test/scheduler.test.js",
        "coverage": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-include=scheduler.js --test-coverage-lines=90 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/scheduler.test.js && node scripts/coverage-badge.js",
        "prepare": "node scripts/install-hooks.js"
    },
    "engines": {
        "node": ">=14"
    },
    "node-red": {
        "version": ">=1.0.0",
        "nodes": {
            "scheduler": "scheduler.js"
        }
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.14.0",
        "globals": "^17.14.0"
    },
    "overrides": {
        "minimatch": "^11.0.1"
    }
}
